<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Wekelijks knooppuntbestand bijwerken: zondag 04:00. Installeren: zie README.md.
     REPO wordt bij installatie vervangen door het pad naar deze repo. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>nl.deboskes.fietsknooppunten.knooppunten</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>REPO/tools/knooppunten/update.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/tmp/fietsknooppunten-knooppunten.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/fietsknooppunten-knooppunten.log</string>
</dict>
</plist>
